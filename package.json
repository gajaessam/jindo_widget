{
  "name": "geupsik-alimi",
  "productName": "급식알리미",
  "version": "0.2.6",
  "description": "내가 고른 캐릭터가 말풍선으로 오늘 급식을 알려주는 PC 위젯",
  "author": "급식알리미",
  "main": "src/main/main.js",
  "private": true,
  "scripts": {
    "start": "electron .",
    "test": "node --test \"test/*.test.js\"",
    "icon": "electron scripts/make-icon.js",
    "dist": "electron-builder --win nsis",
    "share": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/make-share-zip.ps1"
  },
  "build": {
    "appId": "app.geupsikalimi.widget",
    "productName": "급식알리미",
    "files": [
      "src/**",
      "assets/**",
      "package.json"
    ],
    "directories": {
      "output": "dist"
    },
    "win": {
      "icon": "assets/icon.png",
      "artifactName": "geupsik-alimi-setup-${version}.${ext}"
    },
    "publish": [
      {
        "provider": "github",
        "owner": "gajaessam",
        "repo": "hungry-widget"
      }
    ],
    "electronLanguages": [
      "ko",
      "en-US"
    ],
    "compression": "maximum"
  },
  "devDependencies": {
    "electron": "^45.2.3",
    "electron-builder": "^26.18.0"
  },
  "dependencies": {
    "electron-updater": "^6.8.11"
  },
  "repository": "https://github.com/gajaessam/hungry-widget"
}
